# Copy to frontend/.env for local development (vite reads it at startup).

# API gateway.
VITE_API_BASE_URL=http://localhost:8088

# Keycloak. Must match KEYCLOAK_PUBLIC_URL in the root .env, because the token
# this issues is validated against that same URL by every resource server.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=chargegrid
VITE_KEYCLOAK_CLIENT_ID=chargegrid-frontend

# Basemap style. Defaults to CARTO's keyless dark basemap over OpenStreetMap
# data; point this at another provider's style URL to change it.
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Stripe publishable key. Public by design: it can only create payment methods,
# never move money. The matching secret key lives in the root .env, server-side.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TqynuJ3HtnJuoVn0ScBYoCVWrz7a3LGBopyZJ1OIhjgtTSL9k0zfzqswoX7BlJqzVLX3Sz26bupXOm0B4bi4P6B00co9JXs2D

# Operator key for the charger simulator. Stands in for hardware credentials;
# in production a charger would use its own client-credentials token instead of
# a shared key shipped to a browser.
VITE_ADMIN_KEY=demo-admin-key

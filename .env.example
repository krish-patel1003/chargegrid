POSTGRES_USER=chargegrid
POSTGRES_PASSWORD=replace_me
# Bootstrap database. Per-service databases are created by
# infrastructure/postgres/init/01-create-databases.sql.
POSTGRES_DB=chargegrid
RABBITMQ_USER=chargegrid
RABBITMQ_PASSWORD=replace_me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_me
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
RESEND_API_KEY=replace_me
STATION_ADMIN_KEY=replace_me
# Public Keycloak URL. Must be the hostname the browser uses, because it ends
# up in the `iss` claim that every resource server validates.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
